# ─────────────────────────────────────────
#  SONG4HER 🦋  Environment Configuration
# ─────────────────────────────────────────

# Database (SQLite) — relative to project root
DATABASE_URL="file:./data/database/song4her.db"

# Admin Authentication
# Run `npm run setup` to generate this hash from your password
ADMIN_PASSWORD_HASH=

# Session secret — change to a long random string (32+ chars)
SESSION_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Server Ports
PORT=3000          # Next.js frontend port
PORT_API=3001      # Fastify API server port

# Data directory (absolute path or relative to project root)
DATA_DIR=./data

# Node environment
NODE_ENV=development

# API URL for Next.js server-side fetches (internal, not public)
API_URL=http://localhost:3001

# Socket.IO URL (for admin browser client to connect)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Cloudflared binary path (leave blank to use from PATH)
# CLOUDFLARED_PATH=cloudflared
